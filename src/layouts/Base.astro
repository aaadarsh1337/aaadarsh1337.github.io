---
import "../styles/global.css";
import { createHash } from "node:crypto";
import TopBar from "../components/TopBar.astro";
import Palette from "../components/Palette.astro";
import Seal from "../components/Seal.astro";
import Kanji from "../components/Kanji.astro";
// the seven virtues of bushidō, along the footer; each names itself on hover, focus or tap
const virtues = [["義", "rectitude"], ["勇", "courage"], ["仁", "benevolence"], ["礼", "respect"], ["誠", "honesty"], ["名誉", "honour"], ["忠義", "loyalty"]];
import { site } from "../config";
import { phaseInstants } from "../lib/moon";
import { person, website, abs, plainTitle } from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  /** Current section for nav state: "home" | "writeups" | "blog" | "intel" | "about" */
  section?: string;
  image?: string;
  type?: "website" | "article";
  /** schema.org objects for this page (merged into one @graph with the breadcrumbs) */
  jsonld?: Record<string, unknown> | Record<string, unknown>[];
  /** Breadcrumb levels between Home and this page, for search results. */
  crumbs?: { name: string; url: string }[];
  noindex?: boolean;
  published?: Date | null;
  /** Full-bleed page (home): no centred reading frame. */
  wide?: boolean;
}
const { title: rawTitle, section = "", image = "/assets/og.png", type = "website", jsonld, published, wide = false, crumbs = [], noindex = false } = Astro.props;
const title = rawTitle && plainTitle(rawTitle);
const description = Astro.props.description
  ?? `${site.profile.name} (${site.profile.handle}), a ${site.profile.company.role.toLowerCase()} at ${site.profile.company.name} and a cybersecurity student, playing CTFs for ${site.profile.team}. Writeups, malware analysis and a live SSH honeypot.`;
const fullTitle = title ? `${title} · ${site.profile.name}` : site.profile.name;
const canonical = new URL(Astro.url.pathname, site.url).href;
// One @graph per page: the page's own objects, its breadcrumbs, and on the home and
// About pages the full Person (elsewhere articles point at it by @id).
const isHome = Astro.url.pathname === "/";
const own = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]).map(({ ["@context"]: _c, ...o }) => o) : [];
const trail = isHome || noindex ? [] : [{ name: "Home", url: site.url + "/" }, ...crumbs.map((c) => ({ name: c.name, url: abs(c.url) })), { name: (title ?? site.profile.name).split(" · ")[0], url: canonical }];
const graph = [
  ...(isHome ? [website(), person()] : []),
  ...(section === "about" ? [{ "@type": "ProfilePage", url: canonical, name: fullTitleFor(title), mainEntity: person() }] : []),
  ...own,
  ...(trail.length ? [{ "@type": "BreadcrumbList", itemListElement: trail.map((t, i) => ({ "@type": "ListItem", position: i + 1, name: t.name, item: t.url })) }] : []),
];
function fullTitleFor(t?: string) { return t ? `${t} · ${site.profile.name}` : site.profile.name; }

// No-flash theme: runs before first paint. Its hash goes into the CSP so no
// other inline script can run. It keeps the secret blood-moon theme across pages
// (sessionStorage; a reload ends it), marks full/new moon nights and the visitor's
// night hours, for the stars. A full or new moon day is the visitor's calendar day holding
// the true instant (lib/moon.ts), precomputed here from 60 days back to 180 days ahead.
const lunarInstants = phaseInstants(new Date(Date.now() - 60 * 864e5), new Date(Date.now() + 180 * 864e5))
  .map((x) => `[${Math.round(x.at / 6e4)},'${x.kind}']`).join(",");
const themeScript = `(function(){var d=document.documentElement;try{var q=new URLSearchParams(location.search).get('theme'),t=q==='dawn'||q==='light'?'dawn':q==='night'||q==='dark'?'night':localStorage.getItem('theme'),b=sessionStorage.getItem('blood');if(b){var n=performance.getEntriesByType('navigation')[0];if(n&&n.type==='reload'){sessionStorage.removeItem('blood');b=null}}if(b)d.classList.add('blood');else if(t==='dawn')d.dataset.theme='dawn'}catch(e){}var D=new Date().toDateString(),w=[${lunarInstants}];for(var i=0;i<w.length;i++)if(new Date(w[i][0]*6e4).toDateString()===D)d.dataset.lunar=w[i][1];var h=new Date().getHours();if(h>=19||h<5)d.dataset.night='';d.classList.add('js')})()`;
const hash = createHash("sha256").update(themeScript).digest("base64");
const csp = [
  "default-src 'self'",
  // wasm-unsafe-eval lets the Pagefind search index compile its WebAssembly; it allows no eval of script
  `script-src 'self' 'sha256-${hash}' 'wasm-unsafe-eval'`,
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data:",
  "font-src 'self'",
  "connect-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'none'",
].join("; ");
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta http-equiv="Content-Security-Policy" content={csp} />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <script is:inline set:html={themeScript}></script>
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#0b0e13" />
  <meta name="color-scheme" content="dark light" />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title ?? site.profile.name} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(image, site.url).href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title ? `${title}, by ${site.profile.name}` : `${site.profile.name} (${site.profile.handle})`} />
  <meta name="twitter:image" content={new URL(image, site.url).href} />
  <meta property="og:site_name" content={`${site.profile.name} · ${site.profile.handle}`} />
  {published && <meta property="article:published_time" content={published.toISOString()} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:creator" content="@aaadarsh1337" />
  {noindex && <meta name="robots" content="noindex" />}
  {graph.length > 0 && <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": graph })} />}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <TopBar section={section} />
  <main id="main" class:list={["main", { "main--wide": wide }]} tabindex="-1">
    <slot />
  </main>
  <footer class="foot">
    <ul class="virtues" aria-label="The seven virtues of bushidō">
      {virtues.map(([k, en]) => <li tabindex="0"><Kanji text={k} /><span class="virtue__en">{en}</span></li>)}
    </ul>
    <p class="foot__who">
      <Seal />
      <span><span class="foot__name">{site.profile.name}</span>, {site.profile.tagline.join(", ").toLowerCase()}</span>
    </p>
    <nav aria-label="Elsewhere">
      <a href={`https://github.com/${site.github.user}`} rel="external">GitHub</a>
      <a href={site.links.find((l) => l.label === "TryHackMe")?.url} rel="external">TryHackMe</a>
      <a href={site.links.find((l) => l.label === "CTFtime")?.url} rel="external">CTFtime</a>
    </nav>
    <p class="foot__end">{new Date().getUTCFullYear()} · {site.profile.motto}</p>
  </footer>
  <Palette />
  <script>
    // heading moons wax down the page: a thin crescent at the first, nearly full at the last
    // (always a sliver of shadow, so even the last one reads as a moon, not a dot)
    import { litPath } from "../lib/moon";
    const hs = [...document.querySelectorAll<HTMLElement>(":is(.b-h, .label, .tb__h, .month__h, .prose h2)")].filter((h) => h.offsetParent);
    hs.forEach((h, i) => {
      const phase = hs.length > 1 ? 0.09 + 0.28 * (i / (hs.length - 1)) : 0.25;
      const svg = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><circle cx='12' cy='12' r='11' fill-opacity='.26'/><path d='${litPath(phase, 12, 11)}'/></svg>`;
      h.style.setProperty("--moon-mask", `url("data:image/svg+xml,${encodeURIComponent(svg)}")`);
    });

    // inner pages: each block arrives once as it scrolls in (the home page runs its own)
    if (!document.querySelector(".main--wide") && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("is-in"); io.unobserve(e.target); } }), { rootMargin: "0px 0px -6% 0px" });
      document.querySelectorAll(".main section > *, .main .month li, .main .posts > li").forEach((el) => {
        const r = el.getBoundingClientRect();
        if (r.top > innerHeight && r.height < innerHeight * 0.6 && !el.querySelector("img")) { el.classList.add("will-rise"); io.observe(el); }
      });
    }
  </script>
</body>
</html>

<style>
  /* short pages: keep the footer at the bottom of the screen */
  :global(body) { display: flex; flex-direction: column; min-height: 100svh; }
  .main { flex: 1 0 auto; }
  .skip { position: absolute; left: var(--s4); top: -4rem; z-index: 10; padding: var(--s2) var(--s4); background: var(--moon); color: #0b0e13; font: 500 var(--t-small)/1.4 var(--sans); }
  .skip:focus { top: var(--s4); }
  /* inner pages: one centred frame; the home page draws its own full-bleed rooms */
  .main { display: block; width: min(100% - 2 * var(--margin), 64rem); margin-inline: auto; padding-block: var(--s8) 0; outline: none; }
  .main--wide { width: 100%; padding: 0; }
  .foot {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: var(--s4) var(--s6);
    margin-top: var(--gap); padding: var(--s6) var(--margin);
    background: var(--bg-1);
    font-size: var(--t-small); color: var(--muted);
  }
  .foot nav { display: flex; gap: var(--s5); }
  .virtues { grid-column: 1 / -1; list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s2) clamp(.9rem, 3vw, 3rem); padding-bottom: calc(var(--s5) + 1.1rem);   /* one centred group; the spacing scales with the screen */ margin-bottom: var(--s2); border-bottom: 1px solid var(--rule); }
  .virtues li { position: relative; display: block; line-height: 0; font-size: 1.375rem; color: color-mix(in oklab, var(--lily) 52%, var(--bg)); cursor: default; outline-offset: 4px; transition: color .3s var(--ease); }
  .virtue__en { position: absolute; left: 50%; top: calc(100% + 8px); translate: -50% -3px; white-space: nowrap; font: 400 var(--t-small)/1 var(--sans); color: var(--fg-2); opacity: 0; transition: opacity .3s var(--ease), translate .3s var(--ease); }
  .virtues li:is(:hover, :focus, :focus-within) { color: var(--lily); }
  .virtues li:is(:hover, :focus, :focus-within) .virtue__en { opacity: 1; translate: -50% 0; }
  .foot__who { display: flex; align-items: center; gap: var(--s4); }
  .foot__name { font: 600 1em/1 var(--voice); letter-spacing: -.03em; color: var(--fg); }
  .foot a { color: var(--fg); transition: color .2s; }
  .foot a:hover { color: var(--bone); }
  .foot__end { text-align: right; }
  @media (max-width: 860px) {
    .main { padding-block: var(--s6) 0; }
    .foot { grid-template-columns: 1fr; gap: var(--s2); padding-block: var(--s5); font-size: .875rem; }
    .virtues li { font-size: 1.125rem; }
    .foot nav { flex-wrap: wrap; gap: var(--s2) var(--s5); }
    .foot__end { text-align: left; }
  }
</style>
