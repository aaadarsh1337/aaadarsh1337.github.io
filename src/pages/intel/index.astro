---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import Blades from "../../components/Blades.astro";
import { site } from "../../config";
import { getMetrics, days, cutoff } from "../../lib/intel";
import { day, num } from "../../lib/format";
import { existsSync } from "node:fs";
import { join } from "node:path";
import { getPosts } from "../../lib/blog";
import { render } from "../../lib/markdown";
import { defang, lookups } from "../../lib/ioc";
const funnel = existsSync(join(process.cwd(), "public/intel/session-funnel.png"));
const bendi = (await getPosts()).find((x) => x.slug === "bendi");

const { metrics: m, live } = getMetrics();
const f = site.flagship;
const series = days(m);
const peak = series.reduce((a, b) => (b.events > a.events ? b : a));
const cut = cutoff(m);
const cutText = `${day(cut)}, ${cut.toISOString().slice(11, 16)} UTC`;
const start = new Date(`${m.observation_period.start}T00:00:00Z`);
const dur = m.sessions.session_duration_seconds;
const cats = Object.entries(m.behavioral_command_categories as Record<string, number>).sort((a, b) => b[1] - a[1]);
const catTotal = cats.reduce((s, [, v]) => s + v, 0);
const pct = (v: number, t: number) => (v > 0 && v / t < 0.001 ? "<0.1%" : `${((v / t) * 100).toFixed(1)}%`);   // a rare event is still an event
const discovery = pct((m.behavioral_command_categories as Record<string, number>).discovery ?? 0, catTotal);
// Everything the sensor publishes, in full: no truncated commands or hashes.
const users = m.logins.top_usernames;
const pws = m.logins.top_passwords ?? [];
const cmdTotal = m.commands.input_events;
const commands = await Promise.all(m.commands.top_commands.map(async (c) => {
  const text = defang(c.input);                       // attacker text: URLs/IPs defanged
  const lines = text.split("\n").length;
  const long = lines > 1 || text.length > 160;        // scripts open in a highlighted listing
  return { ...c, text, lines, long, listing: long ? (await render("````bash\n" + text + "\n````")).html : "" };
}));
const nets = m.sources.top_source_net16_by_event_volume;
const dests = m.downloads_uploads.top_destfiles;
const shas = m.downloads_uploads.top_shasums ?? [];
const events = Object.entries(m.event_ids as Record<string, number>).sort((a, b) => b[1] - a[1]);
const snippets = [
  { label: "Today's indicators as plain text", cmd: `curl -s ${site.url}/intel/iocs.txt` },
  { label: "Top commands, with jq", cmd: `curl -s ${site.url}/intel/data.json | jq '.commands.top_commands'` },
  { label: "Just the SHA-256 hashes", cmd: `curl -s ${site.url}/intel/iocs.csv | awk -F, '$1=="sha256" {print $2}'` },
  { label: "Most-attempted passwords as a deny-list", cmd: `curl -s ${site.url}/intel/iocs.json | jq -r '.indicators[] | select(.type=="password") | .value'` },
];
const downloads = [
  { href: "/intel/iocs.txt", label: "iocs.txt", what: "one value per line" },
  { href: "/intel/iocs.csv", label: "iocs.csv", what: "type, value, count" },
  { href: "/intel/iocs.json", label: "iocs.json", what: "indicators as JSON" },
  { href: "/intel/data.json", label: "data.json", what: "every aggregate" },
];
const gh = f.links.github;

const jsonld = {
  "@context": "https://schema.org", "@type": "Dataset",
  name: "Threat Harbour: SSH honeypot case study",
  description: "A daily Cowrie SSH sensor case study: credential leaderboard, command samples, sources, and defensive takeaways.",
  url: `${site.url}/intel/`, creator: { "@type": "Person", name: site.profile.name, url: site.url },
  temporalCoverage: `${m.observation_period.start}/${m.observation_period.end}`,
  distribution: [
    { "@type": "DataDownload", encodingFormat: "text/csv", contentUrl: `${site.url}/intel/iocs.csv` },
    { "@type": "DataDownload", encodingFormat: "application/json", contentUrl: `${site.url}/intel/iocs.json` },
    { "@type": "DataDownload", encodingFormat: "text/plain", contentUrl: `${site.url}/intel/iocs.txt` },
    { "@type": "DataDownload", encodingFormat: "application/json", contentUrl: `${site.url}/intel/data.json` },
  ],
};
---
<Base title="Threat Harbour SSH honeypot" description={`Threat Harbour case study: a daily SSH honeypot snapshot with ${num(m.totals.total_events)} events, ${num(m.sources.unique_source_ips)} IPs, top attacker passwords and commands. Rebuilt daily; cutoff ${cutText}.`} section="intel" jsonld={jsonld}>
  <PageHead crumbs={[{ label: "threat-harbour" }]} title={f.name} lede={f.description}>
    <p class="sub meta"><span class="live" data-live={live ? "" : undefined}></span>{f.tagline}<span class="sep">·</span>data to {cutText}{!live && <><span class="sep">·</span>cached snapshot</>}</p>
  </PageHead>

  <dl class="kpis">
    <div><dt>events</dt><dd>{num(m.totals.total_events)}</dd></div>
    <div><dt>source IPs</dt><dd>{num(m.sources.unique_source_ips)}</dd></div>
    <div><dt>sessions</dt><dd>{num(m.sessions.unique_session_ids)}</dd></div>
    <div><dt>median session</dt><dd>{dur.median.toFixed(2)}<small>s</small></dd></div>
  </dl>

  <section class="sec">
    <h2 class="label">Event volume per UTC day since {day(start)}</h2>
    <Blades series={series} height={150} class="chart">
      <figcaption class="meta chart__cap">
        <span>peak <b>{num(peak.events)}</b> on {day(new Date(`${peak.day}T00:00:00Z`))}</span>
        <span>dotted blade = today, still collecting</span>
        <span>Botnet sweeps against this sensor, not global trends.</span>
      </figcaption>
    </Blades>
  </section>

  <section class="sec">
    <h2 class="label">Credentials bots try first</h2>
    <p class="note">If it's in this table, bots are trying it against your servers too.</p>
    <div class="cols">
      {[["usernames", users], ["passwords", pws]].map(([title, rows]) => (
        <div>
          <h3 class="h3 meta">top {title as string}</h3>
          <ol class="bars">
            {(rows as { value: string; count: number }[]).map((r) => (
              <li style={`--w:${(r.count / (rows as { count: number }[])[0].count) * 100}%`}>
                <span class="bars__k">{r.value}</span><span class="bars__v">{num(r.count)}</span><button class="cp" type="button" data-copy-value={r.value} aria-label={`Copy ${(title as string).slice(0, -1)} ${r.value}`}><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><rect x="5" y="5" width="8.5" height="8.5" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M10.5 3.2V3a1.5 1.5 0 0 0-1.5-1.5H3.5A1.5 1.5 0 0 0 2 3v5.5A1.5 1.5 0 0 0 3.5 10h.3" fill="none" stroke="currentColor" stroke-width="1.3"/></svg></button>
              </li>
            ))}
          </ol>
          <p class="more"><button class="btn btn--sm" type="button" data-copy-value={(rows as { value: string }[]).map((r) => r.value).join("\n")}>Copy all {(rows as unknown[]).length} as a blocklist</button></p>
        </div>
      ))}
    </div>
  </section>

  <section class="sec">
    <h2 class="label">Top commands</h2>
    <p class="note">{discovery} discovery/fingerprinting: automated recon, not humans.</p>
    <p class="warn">Attacker-supplied text, shown inert and defanged: any URL reads <code>hxxp://host[.]tld</code> and any IP <code>1.2.3[.]4</code>. Don't run it.</p>
    <ol class="cmd">
      {commands.map((c, i) => (
        <li>
          <p class="cmd__head"><span class="cmd__n">#{i + 1}</span><span class="cmd__count">{num(c.count)} runs<span class="sep">·</span>{pct(c.count, cmdTotal)} of all commands</span></p>
          {c.long ? (
            <details class="cmd__long">
              <summary><code>{c.text.split("\n")[0].slice(0, 90)}…</code><span class="cmd__more">{c.lines} lines, show all</span></summary>
              <Fragment set:html={c.listing} />
            </details>
          ) : (
            <div class="cmd__one"><code>{c.text}</code><button class="cp" type="button" data-copy-value={c.text} aria-label={`Copy command ${i + 1}`}><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><rect x="5" y="5" width="8.5" height="8.5" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M10.5 3.2V3a1.5 1.5 0 0 0-1.5-1.5H3.5A1.5 1.5 0 0 0 2 3v5.5A1.5 1.5 0 0 0 3.5 10h.3" fill="none" stroke="currentColor" stroke-width="1.3"/></svg></button></div>
          )}
        </li>
      ))}
    </ol>
  </section>

  <div class="cols cols--sec">
    <section class="sec">
      <h2 class="label">Command categories</h2>
      <p class="note">How the sensor classifies every command input.</p>
      <ol class="bars bars--cat">
        {cats.map(([k, v]) => <li style={`--w:${(v / cats[0][1]) * 100}%`}><span class="bars__k">{k}</span><span class="bars__v">{pct(v, catTotal)}</span></li>)}
      </ol>
    </section>
    <section class="sec">
      <h2 class="label">Busiest /16s</h2>
      <p class="note">Volume only. A source IP never identifies the operator.</p>
      <ol class="bars">
        {nets.map((n) => <li style={`--w:${(n.events / nets[0].events) * 100}%`}><span class="bars__k">{n.cidr}</span><span class="bars__v">{num(n.events)}</span><button class="cp" type="button" data-copy-value={n.cidr} aria-label={`Copy ${n.cidr}`}><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><rect x="5" y="5" width="8.5" height="8.5" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M10.5 3.2V3a1.5 1.5 0 0 0-1.5-1.5H3.5A1.5 1.5 0 0 0 2 3v5.5A1.5 1.5 0 0 0 3.5 10h.3" fill="none" stroke="currentColor" stroke-width="1.3"/></svg></button></li>)}
      </ol>
      <p class="more"><button class="btn btn--sm" type="button" data-copy-value={nets.map((n) => n.cidr).join("\n")}>Copy all {nets.length} CIDRs</button></p>
    </section>
  </div>

  <div class="cols cols--sec">
    <section class="sec">
      <h2 class="label">How long they stay</h2>
      <p class="note">Short, bursty, automated.</p>
      <dl class="facts">
        <div><dt>median</dt><dd>{dur.median.toFixed(2)} s</dd></div>
        <div><dt>under 10 s</dt><dd>{pct(dur.under_10s, dur.n_closed_matched)}</dd></div>
        <div><dt>longest</dt><dd>{(dur.max / 3600).toFixed(1)} h</dd></div>
        <div><dt>fake logins accepted</dt><dd>{num(m.logins.success_fake)}</dd></div>
      </dl>
    </section>
    <section class="sec">
      <h2 class="label">The sensor</h2>
      <p class="note">What collected this, and how much of it.</p>
      <dl class="facts">
        <div><dt>honeypot</dt><dd>Cowrie {m.stack.cowrie}, SSH only</dd></div>
        <div><dt>log pipeline</dt><dd>Promtail {m.stack.promtail} to Loki {m.stack.loki}</dd></div>
        <div><dt>operator dashboards</dt><dd>Grafana {m.stack.grafana}</dd></div>
        <div><dt>log files parsed</dt><dd>{num(m.collection.files)}</dd></div>
        <div><dt>malformed lines skipped</dt><dd>{num(m.totals.bad_json_lines)}</dd></div>
        <div><dt>observing since</dt><dd>{day(start)}</dd></div>
      </dl>
    </section>
  </div>

  <section class="sec">
    <h2 class="label">Files attackers wrote</h2>
    <p class="note">{num(m.downloads_uploads.file_download_events)} download and {num(m.downloads_uploads.file_upload_events)} upload events. Destinations and SHA-256 hashes only; contents withheld. Paths and hashes are listed separately because the data doesn't link one to the other.</p>
    <div class="cols cols--files">
      <div>
        <h3 class="h3 meta">destination paths</h3>
        <ol class="rows">
          {dests.map((d) => <li><code>{d.value}</code><span class="rows__end"><span class="meta">{num(d.count)}</span><button class="cp" type="button" data-copy-value={d.value} aria-label={`Copy path ${d.value}`}><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><rect x="5" y="5" width="8.5" height="8.5" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M10.5 3.2V3a1.5 1.5 0 0 0-1.5-1.5H3.5A1.5 1.5 0 0 0 2 3v5.5A1.5 1.5 0 0 0 3.5 10h.3" fill="none" stroke="currentColor" stroke-width="1.3"/></svg></button></span></li>)}
        </ol>
      </div>
      <div>
        <h3 class="h3 meta">sha256</h3>
        <ol class="rows rows--hash">
          {shas.map((s) => (
            <li>
              <code class="hash">{s.value}</code>
              <span class="rows__end"><span class="meta">{num(s.count)} events</span><button class="cp" type="button" data-copy-value={s.value} aria-label={`Copy hash ${s.value}`}><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><rect x="5" y="5" width="8.5" height="8.5" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M10.5 3.2V3a1.5 1.5 0 0 0-1.5-1.5H3.5A1.5 1.5 0 0 0 2 3v5.5A1.5 1.5 0 0 0 3.5 10h.3" fill="none" stroke="currentColor" stroke-width="1.3"/></svg></button></span>
              <span class="look">look up on {lookups(s.value).map((l, i) => <>{i > 0 && <span class="sep">·</span>}<a href={l.url} rel="external noopener">{l.label}<span class="visually-hidden"> (hash {s.value.slice(0, 12)})</span> <span aria-hidden="true">↗</span></a></>)}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="sec">
    <h2 class="label">Every Cowrie event type</h2>
    <p class="note">All {events.length} event types the sensor logged, out of {num(m.totals.total_events)} events.</p>
    <ol class="evs">
      {events.map(([k, v]) => <li><code>{k}</code><span class="meta">{num(v)}</span><span class="evs__pct">{pct(v, m.totals.total_events)}</span></li>)}
    </ol>
  </section>

  <section class="sec seen">
    <h2 class="label">What it caught</h2>
    <div class="seen__grid">
      {funnel && <figure class="seen__fig seen__fig--wide"><img src="/intel/session-funnel.png" width="1515" height="1013" alt="Session funnel diagram from the Threat Harbour repository" decoding="async" /><figcaption>Session funnel, from the threat-harbour repository</figcaption></figure>}
      {bendi && <>
        <figure class="seen__fig"><img src={`${bendi.url}komari.png`} width="1920" height="1023" alt="The attacker's Komari monitoring dashboard the worm reports to" decoding="async" /><figcaption>The attacker's Komari dashboard</figcaption></figure>
        <figure class="seen__fig"><img src={`${bendi.url}login.png`} width="1920" height="1025" alt="The Komari control panel login page" decoding="async" /><figcaption>Its control panel login</figcaption></figure>
        <p class="seen__text">{bendi.summary}. <a class="btn" href={bendi.url}>Read the analysis of {bendi.title.replace(/^.*?(?:\s[\u2014\u2013-]\s|:\s)/, "")} <span class="arr">→</span></a></p>
      </>}
    </div>
  </section>

  <section class="sec">
    <h2 class="label">Defensive takeaways</h2>
    <ol class="takeaways">
      <li><h3>Blocklist these passwords</h3><p>Deny-list the top 10 in your IdP; require manager-generated secrets.</p></li>
      <li><h3>Expect recon, not intrusion</h3><p>Mostly <code>uname/hostname/whoami</code> in <code>{dur.median.toFixed(2)}s</code> sessions. Alert on discovery bursts, not single logins.</p></li>
      <li><h3>Watch persistence paths</h3><p>Writes toward <code>authorized_keys</code> keep recurring. Alert on any unexpected one.</p></li>
    </ol>
  </section>

  <section class="sec" id="data">
    <h2 class="label">Use the data</h2>
    <p class="note">Indicators regenerate with every daily deploy, from the same aggregates as this page.</p>
    <ul class="dls">
      {downloads.map((d) => <li><a href={d.href} download><span class="dls__name">{d.label}</span><span class="dls__what">{d.what}</span><span class="cue cue--corner" aria-hidden="true">↓</span></a></li>)}
    </ul>
    <ol class="snips">
      {snippets.map((s, i) => <li><p class="snips__k">{s.label}</p><div class="snip"><code>{s.cmd}</code><button class="cp" type="button" data-copy-value={s.cmd} aria-label={`Copy: ${s.label}`}><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><rect x="5" y="5" width="8.5" height="8.5" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M10.5 3.2V3a1.5 1.5 0 0 0-1.5-1.5H3.5A1.5 1.5 0 0 0 2 3v5.5A1.5 1.5 0 0 0 3.5 10h.3" fill="none" stroke="currentColor" stroke-width="1.3"/></svg></button></div></li>)}
    </ol>
  </section>

  <section class="sec">
    <h2 class="label">How it works</h2>
    <div class="how">
      <ul class="steps">{f.highlights.map((h) => <li>{h}</li>)}</ul>
      <div class="method">
        <p>{m.method}</p>
        <p>Aggregates are published daily; the full dataset ships alongside as <a class="link" href="/intel/data.json">data.json</a>.</p>
        <p>One VM, one IP, one region: what hit this sensor, not the internet. Never attribution.</p>
        <p class="stack">{f.stack.map((s) => <span>{s}</span>)}</p>
      </div>
    </div>
    <p class="actions">
      <a class="btn" href={gh} rel="external">threat-harbour repo <span class="arr">↗</span></a>
      <a class="btn" href={f.links.docs} rel="external">methodology docs <span class="arr">↗</span></a>
      <a class="btn" href={`${gh}/blob/main/analysis/summary.md`} rel="external">full tables <span class="arr">↗</span></a>
      <a class="btn" href="/intel/data.json">data.json</a>
    </p>
  </section>
</Base>

<style>
  .sub { margin-top: var(--s5); display: flex; flex-wrap: wrap; align-items: center; font-size: var(--t-small); color: var(--fg-2); }
  .live { width: 8px; height: 8px; border-radius: 50%; background: var(--muted); margin-right: var(--s2); }
  .live[data-live] { background: var(--blue); animation: pulse 3s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: .35; } }

  .kpis { margin: var(--s8) 0 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s3); }
  .kpis div { container-type: inline-size; min-width: 0; padding: var(--s5); background: var(--bg-1); display: flex; flex-direction: column-reverse; gap: var(--s3); }
  .kpis dt { font-size: var(--t-body); color: var(--fg-2); }
  .kpis dd { margin: 0; font: 400 clamp(1.5rem, 17cqi, 3.25rem)/1 var(--sans); white-space: nowrap; letter-spacing: -.04em; color: var(--bone); font-variant-numeric: tabular-nums; }
  .kpis small { font-size: .5em; color: var(--fg-2); margin-left: .1em; }

  .sec { margin-top: var(--gap); }
  .note { margin-top: var(--s3); margin-bottom: var(--s5); font-size: var(--t-body); color: var(--fg-2); line-height: 1.55; }
  :global(.chart) { margin-top: var(--s6); }
  .chart__cap { margin-top: var(--s4); display: flex; flex-wrap: wrap; gap: var(--s2) var(--s6); font-size: var(--t-body); color: var(--fg-2); }
  .chart__cap b { color: var(--lily); font-weight: 400; }

  .cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s7); margin-top: var(--s5); }
  .cols--sec { margin-top: 0; }
  .cols--sec .sec { margin-top: var(--gap); }
  .h3 { font-size: var(--t-body); color: var(--bone); margin-bottom: var(--s4); }
  .bars { list-style: none; display: grid; gap: var(--s2); margin-top: 0; }
  .cols .bars { margin-top: 0; }
  .bars li { position: relative; display: flex; justify-content: space-between; gap: var(--s4); padding: .55rem .8rem; font-size: var(--t-body); line-height: 1.3; }
  .bars li::before { content: ""; position: absolute; inset: 0 auto 0 0; width: var(--w); background: color-mix(in srgb, var(--blue) 17%, var(--bg)); }
  .bars li:first-child::before { background: color-mix(in srgb, var(--lily) 22%, var(--bg)); }
  .bars__k { position: relative; color: var(--fg); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .bars__v { position: relative; color: var(--fg-2); font-variant-numeric: tabular-nums; }

  .cmds { list-style: none; margin-top: 0; display: grid; gap: var(--s2); }
  .cmds li { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s4); padding: .6rem .8rem; background: var(--bg-1); }
  .cmds code { font: 400 .9375rem/1.5 var(--mono); color: var(--fg); overflow-wrap: anywhere; }
  .cmds .meta { font-size: var(--t-body); color: var(--fg-2); }

  .facts { margin: 0; display: grid; gap: var(--s2); }
  .facts div { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s3); padding: .7rem .8rem; background: var(--bg-1); }
  .facts dt { font-size: var(--t-body); color: var(--fg-2); }
  .facts dd { margin: 0; font-size: var(--t-body); color: var(--bone); font-variant-numeric: tabular-nums; }

  .seen__grid { margin-top: var(--s5); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s6) var(--s5); align-items: start; }
  .seen__fig { margin: 0; }
  .seen__fig--wide { grid-column: 1 / -1; }
  .seen__fig img { width: 100%; filter: brightness(.92); }
  .seen__fig--wide img { filter: none; border-radius: 6px; }   /* the funnel is drawn on the page's own --bg (threat-harbour render.py) */
  .seen__fig figcaption { margin-top: var(--s3); font-size: var(--t-small); color: var(--fg-2); }
  .seen__text { grid-column: 1 / -1; max-width: 40rem; font-size: var(--t-body); line-height: 1.6; color: var(--fg); }
  .seen__text .btn { display: flex; width: fit-content; margin-top: var(--s4); }

  .takeaways { list-style: none; margin-top: var(--s5); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s4); }
  .takeaways li { padding: var(--s5); background: var(--bg-1); }
  .takeaways h3 { font: 400 var(--t-lede)/1.25 var(--sans); letter-spacing: -.015em; color: var(--bone); }
  .takeaways p { margin-top: var(--s3); font-size: var(--t-body); line-height: 1.55; color: var(--fg); }
  .takeaways code, .method code { font: 400 .85em var(--mono); color: var(--bone-dim); }

