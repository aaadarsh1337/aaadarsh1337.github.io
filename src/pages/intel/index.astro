</style>

<script>
  // Copy buttons: rows, whole lists, fetch commands, and the highlighted script listings.
  const flash = (b: HTMLElement, msg: string) => { b.dataset.done = msg; setTimeout(() => delete b.dataset.done, 1600); };
  async function copy(b: HTMLElement, text: string) {
    try { await navigator.clipboard.writeText(text); flash(b, "copied"); }
    catch { flash(b, "select + copy"); }
  }
  document.querySelectorAll<HTMLElement>("[data-copy-value]").forEach((b) => b.addEventListener("click", () => copy(b, b.dataset.copyValue ?? "")));
  document.querySelectorAll<HTMLButtonElement>(".cmd [data-copy]").forEach((b) => b.addEventListener("click", async () => {
    const code = b.closest(".listing")?.querySelector("code")?.textContent ?? "";
    try { await navigator.clipboard.writeText(code); b.textContent = "copied"; } catch { b.textContent = "select + copy"; }
    setTimeout(() => (b.textContent = "copy"), 1600);
  }));
  // btn--sm list buttons say so in their own label
  document.querySelectorAll<HTMLButtonElement>(".more [data-copy-value]").forEach((b) => {
    const label = b.textContent;
    b.addEventListener("click", () => setTimeout(() => { if (b.dataset.done) { b.textContent = b.dataset.done === "copied" ? "Copied" : label; setTimeout(() => (b.textContent = label), 1600); } }, 0));
  });
</script>
