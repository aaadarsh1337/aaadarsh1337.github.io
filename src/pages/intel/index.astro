  .cmd__more::before { content: "▸ "; }
  .cmd__long[open] .cmd__more::before { content: "▾ "; }
  .cmd__long :global(.listing) { margin: var(--s3) 0 0; }
  .cmd__long :global(.code) { max-height: 32rem; white-space: pre-wrap; overflow-wrap: anywhere; font-variant-ligatures: none; }   /* read the whole one-liner, no sideways scroll */

  .cols--files { margin-top: 0; }
  .rows { list-style: none; display: grid; gap: var(--s2); }
