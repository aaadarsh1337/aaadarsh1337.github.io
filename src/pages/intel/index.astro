  .cp:hover { color: var(--bone); background: var(--bg-3); }
  .cp[data-done] { color: var(--sage); }
  .cp[data-done]::after { content: attr(data-done); position: absolute; right: 100%; margin-right: .3rem; font: 400 var(--t-small)/1 var(--sans); white-space: nowrap; }
  .bars li .cp { position: relative; z-index: 1; }
  .more { margin-top: var(--s3); }
  .warn { margin: calc(-1 * var(--s2)) 0 var(--s5); padding: var(--s3) var(--s4); border-left: 2px solid var(--lantern); background: color-mix(in srgb, var(--lantern) 7%, transparent); font-size: var(--t-small); line-height: 1.55; color: var(--fg-2); }
  .warn code { font: 400 .95em var(--mono); color: var(--bone-dim); }

  .cmd { list-style: none; display: grid; gap: var(--s3); }
  .cmd li { padding: var(--s4); background: var(--bg-1); border-radius: 6px; min-width: 0; }
  .cmd__head { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--s3); font-size: var(--t-small); color: var(--fg-2); }
  .cmd__n { color: var(--blue); font-variant-numeric: tabular-nums; }
  .cmd__count { font-variant-numeric: tabular-nums; }
  .cmd__one { margin-top: var(--s2); display: flex; align-items: flex-start; justify-content: space-between; gap: var(--s4); }
  .cmd__one code, .cmd__long summary code { font: 400 .9375rem/1.55 var(--mono); color: var(--bone); overflow-wrap: anywhere; white-space: pre-wrap; font-variant-ligatures: none; }
  .cmd__long { margin-top: var(--s2); }
