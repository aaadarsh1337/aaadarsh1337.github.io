---
import Base from "../../layouts/Base.astro";
import Article from "../../components/Article.astro";
import { getWriteups, type Writeup } from "../../lib/writeups";
import { day, iso, minutes } from "../../lib/format";
import { site } from "../../config";
import { abs, personRef, writeupDescription, TOPICS, cardFor } from "../../lib/seo";

export async function getStaticPaths() {
  return (await getWriteups()).map((w) => ({ params: { id: w.id }, props: { w } }));
}
const { w } = Astro.props as { w: Writeup };
const tierHtml = w.tier
  ? `<span class="tier" data-tier="${w.tier}">${w.difficulty}</span>`
  : w.difficulty ?? "";   // a platform's own difficulty name (pwnable.kr's Toddler's Bottle) without a tier
const specs = [
  { k: "platform", v: w.platform },
  ...(w.difficulty ? [{ k: "difficulty", v: tierHtml }] : []),
  { k: "category", v: w.tags.map((t) => `<span class="tag" data-tag="${t}">${t}</span>`).join(" ") },
  { k: "published", v: `<time datetime="${iso(w.date)}">${day(w.date)}</time>` },
  { k: "reading", v: `${minutes(w.body.words, w.body.listings.reduce((s, l) => s + l.lines, 0))} min · ${w.body.listings.length} listings` },
  ...(w.body.challenge ? [{ k: w.body.challenge.label.toLowerCase(), v: new URL(w.body.challenge.url).host + new URL(w.body.challenge.url).pathname.replace(/\/$/, ""), href: w.body.challenge.url }] : []),
  { k: "source", v: "ctf-writeups ↗", href: w.source },
];
const description = writeupDescription(w);
const jsonld = {
  "@type": "TechArticle",
  headline: `${w.title}: ${w.platform} writeup`,
  name: w.title,
  description,
  datePublished: iso(w.date) || undefined,
  dateModified: iso(w.date) || undefined,
  author: personRef(),
  publisher: personRef(),
  image: abs(cardFor.writeup(w.id)),
  url: abs(w.url),
  mainEntityOfPage: abs(w.url),
  inLanguage: "en",
  wordCount: w.body.words,
  about: [w.platform, ...w.tags.map((t) => TOPICS[t] ?? t), "Capture the flag (CTF)"],
  keywords: [w.title, w.platform, `${w.platform} writeup`, ...w.tags.map((t) => TOPICS[t] ?? t), w.difficulty, "CTF writeup"].filter(Boolean).join(", "),
};
---
<Base title={`${w.title} · ${w.platform} writeup`} description={description} section="writeups" type="article" published={w.date} jsonld={jsonld} image={cardFor.writeup(w.id)}
  crumbs={[{ name: "CTF writeups", url: "/writeups/" }, { name: w.platform, url: `/writeups/?platform=${encodeURIComponent(w.platform)}` }]}>
  <Article
    crumbs={[{ label: "writeups", href: "/writeups/" }, { label: w.platform, href: `/writeups/?platform=${encodeURIComponent(w.platform)}` }, { label: w.id.split("/").slice(1).join("/") }]}
    title={w.title}
    specs={specs}
    body={w.body}
    attachments={w.attachments}
    prev={w.prev}
    next={w.next}
    series={w.platform}
    standfirst={`A ${w.difficulty ? `${w.difficulty} ` : ""}${w.tags.join(" and ")} challenge from ${w.platform}, ${minutes(w.body.words, w.body.listings.reduce((s, l) => s + l.lines, 0))} minutes to read.`}
  />
</Base>
