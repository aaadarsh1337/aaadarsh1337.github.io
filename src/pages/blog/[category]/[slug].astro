---
import Base from "../../../layouts/Base.astro";
import Article from "../../../components/Article.astro";
import { getPosts, type Post } from "../../../lib/blog";
import { day, iso, minutes } from "../../../lib/format";
import { site } from "../../../config";
import { abs, personRef, cardFor } from "../../../lib/seo";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((p, i) => ({
    params: { category: p.category, slug: p.slug },
    props: { p, newer: posts[i - 1], older: posts[i + 1] },
  }));
}
const { p, newer, older } = Astro.props as { p: Post; newer?: Post; older?: Post };
const specs = [
  { k: "category", v: p.categoryLabel, href: `/blog/${p.category}/` },
  { k: "published", v: `<time datetime="${iso(p.date)}">${day(p.date)}</time>` },
  { k: "reading", v: `${minutes(p.body.words)} min` },
  ...(p.tags.length ? [{ k: "tags", v: p.tags.map((t) => `<span class="tag">${t}</span>`).join(" ") }] : []),
  { k: "source", v: "security-blog ↗", href: p.source },
];
const jsonld = {
  "@type": "BlogPosting", headline: p.title, description: p.summary,
  datePublished: iso(p.date), dateModified: iso(p.date), author: personRef(), publisher: personRef(),
  image: abs(cardFor.post(p.category, p.slug)), url: abs(p.url), mainEntityOfPage: abs(p.url), inLanguage: "en",
  wordCount: p.body.words, articleSection: p.categoryLabel, keywords: [p.categoryLabel, ...p.tags].join(", "),
};
---
<Base title={`${p.title} · ${p.categoryLabel}`} description={p.summary} section="blog" type="article" published={p.date} jsonld={jsonld} image={cardFor.post(p.category, p.slug)}
  crumbs={[{ name: "Security blog", url: "/blog/" }, { name: p.categoryLabel, url: `/blog/${p.category}/` }]}>
  <Article
    crumbs={[{ label: "blog", href: "/blog/" }, { label: p.categoryLabel, href: `/blog/${p.category}/` }, { label: p.slug }]}
    title={p.title}
    specs={specs}
    body={p.body}
    prev={older && { title: older.title, url: older.url }}
    next={newer && { title: newer.title, url: newer.url }}
    standfirst={p.summary}
  />
</Base>
