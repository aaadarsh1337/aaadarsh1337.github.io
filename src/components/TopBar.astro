---
// Plain bar: wordmark (with tonight's moon) and a few links on the left, the one action on the right.
import Moon from "./Moon.astro";
import { site } from "../config";
import { moonPhase, nextPhase } from "../lib/moon";
import { day } from "../lib/format";
const tonight = moonPhase(new Date());

interface Props { section: string }
const { section } = Astro.props;
const nav = [
  { id: "writeups", href: "/writeups/", label: "Writeups" },
  { id: "blog", href: "/blog/", label: "Blog" },
  { id: "intel", href: "/intel/", label: "Threat Harbour" },
  { id: "about", href: "/about/", label: "About" },
];
---
<header class="bar">
  <div class="mark">
    <button class="mark__moonbtn" type="button" popovertarget="tonight" aria-label="Tonight's moon">
      <Moon live halo size={34} class="mark__moon" label="" />
    </button>
    <a class="mark__name" href="/">{site.profile.name}</a>
    <span class="mark__phase" data-moon-name>{tonight.name}</span>
    <div id="tonight" popover class="tonight">
      <div class="tonight__moon"><Moon live size={84} label="" /></div>
      <p class="tonight__k">Tonight</p>
      <p class="tonight__name" data-moon-name>{tonight.name}</p>
      <dl class="tonight__facts">
        <div><dt>Lit</dt><dd data-moon-lit>{Math.round(tonight.illumination * 100)}%</dd></div>
        <div><dt>Age</dt><dd data-moon-age>{tonight.age.toFixed(1)} days</dd></div>
        <div><dt>Next full moon</dt><dd data-moon-full>{day(nextPhase(0.5))}</dd></div>
        <div><dt>Next new moon</dt><dd data-moon-new>{day(nextPhase(0))}</dd></div>
      </dl>
      <p class="tonight__note">Worked out in your browser for your date. It changes every night.</p>
    </div>
  </div>
  <nav class="links" aria-label="Primary">
    {nav.map((n) => <a href={n.href} aria-current={section === n.id ? "page" : undefined}>{n.label}</a>)}
  </nav>
  <div class="end">
    <button class="tool" type="button" data-palette-open aria-label="Search the site"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><circle cx="7" cy="7" r="4.6" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M10.4 10.4 14 14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg></button>
    <button class="tool" type="button" data-theme-toggle aria-label="Switch between night and dawn"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><circle cx="8" cy="8" r="5.6" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M8 2.4a5.6 5.6 0 0 1 0 11.2Z" fill="currentColor"/></svg></button>
    <a class="btn btn--primary bar__cta" href={site.profile.resume}>Résumé</a>
    <details class="menu">
      <summary>Menu</summary>
      <nav aria-label="Primary (menu)">
        {nav.map((n) => <a href={n.href} aria-current={section === n.id ? "page" : undefined}>{n.label}</a>)}
        <a href={site.profile.resume}>Résumé</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .bar {
    position: relative; z-index: 5;
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: var(--s6);
    padding: var(--s5) var(--margin);
    font-size: var(--t-small);
  }
  .mark { position: relative; display: inline-flex; align-items: center; gap: .75rem; }
  .mark__moonbtn { display: grid; place-items: center; padding: 4px; margin: -4px; border: 0; background: none; border-radius: 50%; cursor: pointer; transition: transform .4s var(--ease); }
  .mark__moonbtn:hover { transform: rotate(-12deg) scale(1.06); }
  .mark__moonbtn:active { transform: scale(.94); }
  .mark__moon { view-transition-name: moon; }
  .mark__name { color: var(--bone); font-weight: 500; letter-spacing: -.01em; }
  .mark__phase { color: var(--fg-2); padding-left: .75rem; box-shadow: inset 1px 0 0 var(--rule-2); text-transform: lowercase; }
  .tonight { position: fixed; inset: auto; top: 4.75rem; left: var(--margin); margin: 0; width: min(20rem, calc(100vw - 2 * var(--margin))); padding: var(--s5); border: 0; background: var(--bg-3); color: var(--fg); box-shadow: 0 24px 70px -24px rgb(0 0 0 / .75); /* taste-skill-ignore: a real popover floats */ }
  .tonight:popover-open { animation: tn-in .3s var(--ease); }
  @keyframes tn-in { from { opacity: 0; translate: 0 -6px; } }
  .tonight__moon { display: grid; place-items: center; padding: var(--s4) 0 var(--s5); }
  .tonight__k { font-size: var(--t-small); color: var(--fg-2); }
  .tonight__name { margin-top: 2px; font: 500 1.625rem/1.1 "Shippori Mincho", var(--sans); color: var(--bone); text-transform: capitalize; }
  .tonight__facts { margin: var(--s4) 0 0; display: grid; gap: var(--s2); }
  .tonight__facts div { display: flex; justify-content: space-between; gap: var(--s4); font-size: var(--t-small); }
  .tonight__facts dt { color: var(--fg-2); }
  .tonight__facts dd { margin: 0; color: var(--bone); font-variant-numeric: tabular-nums; }
  .tonight__note { margin-top: var(--s4); font-size: var(--t-small); line-height: 1.45; color: var(--muted); }
  .links { display: flex; gap: var(--s5); }
  .links a, .menu nav a { color: var(--fg-2); transition: color .2s var(--ease); position: relative; }
  .links a:hover, .links a[aria-current="page"] { color: var(--bone); }
  .links a[aria-current="page"]::after { content: ""; position: absolute; left: 0; right: 0; bottom: -6px; height: 2px; border-radius: 2px; background: var(--blue); }
  .end { display: flex; align-items: center; gap: var(--s2); }
  .tool { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border: 0; background: none; color: var(--fg-2); cursor: pointer; transition: color .2s, transform .2s; }
  .tool:hover { color: var(--bone); }
  .tool:active { transform: scale(.92); }
  .bar__cta { margin-left: var(--s2); height: 2.5rem; }
  .menu { display: none; position: relative; }
  .menu summary { list-style: none; cursor: pointer; padding: .55rem .2rem; color: var(--bone); }
  .menu summary::-webkit-details-marker { display: none; }
  .menu nav { position: absolute; right: 0; top: calc(100% + .5rem); display: grid; gap: .25rem; min-width: 12rem; padding: var(--s3); background: var(--bg-3); }
  .menu nav a { padding: .6rem .5rem; font-size: 1.0625rem; }
  @media (max-width: 860px) {
    .bar { grid-template-columns: 1fr auto; padding-block: var(--s4); }
    .links, .bar__cta, .mark__phase { display: none; }
    .menu { display: block; }
  }
</style>

<script>
  const root = document.documentElement;
  document.querySelectorAll("[data-theme-toggle]").forEach((btn) =>
    btn.addEventListener("click", () => {
      const next = root.dataset.theme === "dawn" ? "night" : "dawn";
      if (next === "dawn") root.dataset.theme = "dawn"; else delete root.dataset.theme;
      try { localStorage.setItem("theme", next); } catch {}
    }));
  // local time where Adarsh is
  const fmt = new Intl.DateTimeFormat("en-GB", { hour: "2-digit", minute: "2-digit", timeZone: "Asia/Kolkata" });
  const tick = () => document.querySelectorAll<HTMLElement>("[data-local-time]").forEach((el) => (el.textContent = fmt.format(new Date())));
  tick();
  setInterval(tick, 30_000);
</script>
