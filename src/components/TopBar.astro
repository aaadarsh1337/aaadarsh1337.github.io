---
// Plain bar: wordmark (with tonight's moon) and a few links on the left, the one action on the right.
import Moon from "./Moon.astro";
import { site } from "../config";
import { moonPhase, nextPhase } from "../lib/moon";
import { day } from "../lib/format";
import { getWriteups } from "../lib/writeups";
import { getPosts } from "../lib/blog";
const tonight = moonPhase(new Date());
const [writeups, posts] = await Promise.all([getWriteups(), getPosts()]);

interface Props { section: string }
const { section } = Astro.props;
const nav = [
  { id: "writeups", href: "/writeups/", label: "Writeups", n: writeups.length },
  { id: "blog", href: "/blog/", label: "Blog", n: posts.length },
  { id: "intel", href: "/intel/", label: "Threat Harbour" },
  { id: "about", href: "/about/", label: "About" },
];
const sheetNav = [{ id: "home", href: "/", label: "Home" }, ...nav];
---
<header class="bar" data-bar>
  <div class="mark">
    <button class="mark__moonbtn" type="button" popovertarget="tonight" aria-label="Tonight's moon">
      <Moon live halo size={34} class="mark__moon" label="" />
    </button>
    <a class="mark__name" href="/">{site.profile.name}</a>
    <span class="mark__phase" data-moon-name>{tonight.name}</span>
    <div id="tonight" popover class="tonight">
      <div class="tonight__moon"><Moon live size={84} label="" /></div>
      <p class="tonight__k">Tonight</p>
      <p class="tonight__name" data-moon-name>{tonight.name}</p>
      <dl class="tonight__facts">
        <div><dt>Lit</dt><dd data-moon-lit>{Math.round(tonight.illumination * 100)}%</dd></div>
        <div><dt>Age</dt><dd data-moon-age>{tonight.age.toFixed(1)} days</dd></div>
        <div><dt>Next full moon</dt><dd data-moon-full>{day(nextPhase(0.5))}</dd></div>
        <div><dt>Next new moon</dt><dd data-moon-new>{day(nextPhase(0))}</dd></div>
      </dl>
      <p class="tonight__note">Worked out in your browser for your date. It changes every night.</p>
    </div>
  </div>
  <nav class="links" aria-label="Primary">
    {nav.map((n) => <a href={n.href} aria-current={section === n.id ? "page" : undefined}>{n.label}</a>)}
  </nav>
  <div class="end">
    <button class="tool" type="button" data-palette-open aria-label="Search the site"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><circle cx="7" cy="7" r="4.6" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M10.4 10.4 14 14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg></button>
    <button class="tool" type="button" data-theme-toggle aria-label="Switch between night and dawn"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><circle cx="8" cy="8" r="5.6" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M8 2.4a5.6 5.6 0 0 1 0 11.2Z" fill="currentColor"/></svg></button>
    <a class="btn btn--primary bar__cta" href={site.profile.resume}>Résumé</a>
    <button class="menu-btn" type="button" data-sheet-open aria-haspopup="dialog">Menu</button>
  </div>
</header>

<dialog class="sheet" aria-label="Menu" data-sheet>
  <div class="sheet__top">
    <span class="sheet__mark"><Moon live size={28} label="" />{site.profile.name}</span>
    <button class="sheet__close" type="button" data-sheet-close aria-label="Close menu">Close</button>
  </div>
  <nav class="sheet__nav" aria-label="Primary">
    {sheetNav.map((n) => (
      <a href={n.href} aria-current={section === n.id ? "page" : undefined}>
        <span>{n.label}</span>{"n" in n && n.n !== undefined && <sup>{n.n}</sup>}
      </a>
    ))}
    <a href={site.profile.resume}><span>Résumé</span><sup>pdf</sup></a>
  </nav>
  <div class="sheet__tonight">
    <Moon live size={56} label="" />
    <div>
      <p class="sheet__k">Tonight</p>
      <p class="sheet__phase"><span data-moon-name>{tonight.name}</span>, <span data-moon-lit>{Math.round(tonight.illumination * 100)}%</span> lit</p>
      <p class="sheet__next">Next full moon <span data-moon-full>{day(nextPhase(0.5))}</span></p>
    </div>
  </div>
  <div class="sheet__tools">
    <button class="btn" type="button" data-sheet-search>Search</button>
    <button class="btn" type="button" data-theme-toggle><span data-theme-name>Switch theme</span></button>
  </div>
</dialog>

<style>
  .bar {
    position: relative; z-index: 5;
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: var(--s6);
    padding: var(--s5) var(--margin);
    font-size: var(--t-small);
  }
  .mark { position: relative; display: inline-flex; align-items: center; gap: .75rem; }
  .mark__moonbtn { display: grid; place-items: center; padding: 4px; margin: -4px; border: 0; background: none; border-radius: 50%; cursor: pointer; transition: transform .4s var(--ease); }
  .mark__moonbtn:hover { transform: rotate(-12deg) scale(1.06); }
  .mark__moonbtn:active { transform: scale(.94); }
  .mark__moon { view-transition-name: moon; }
  .mark__name { color: var(--bone); font-weight: 500; letter-spacing: -.01em; }
  .mark__phase { color: var(--fg-2); padding-left: .75rem; box-shadow: inset 1px 0 0 var(--rule-2); text-transform: lowercase; }
  .tonight { position: fixed; inset: auto; top: 4.75rem; left: var(--margin); margin: 0; width: min(20rem, calc(100vw - 2 * var(--margin))); padding: var(--s5); border: 0; background: var(--bg-3); color: var(--fg); box-shadow: 0 24px 70px -24px rgb(0 0 0 / .75); /* taste-skill-ignore: a real popover floats */ }
  .tonight:popover-open { animation: tn-in .3s var(--ease); }
  @keyframes tn-in { from { opacity: 0; translate: 0 -6px; } }
  .tonight__moon { display: grid; place-items: center; padding: var(--s4) 0 var(--s5); }
  .tonight__k { font-size: var(--t-small); color: var(--fg-2); }
  .tonight__name { margin-top: 2px; font: 500 1.625rem/1.1 "Shippori Mincho", var(--sans); color: var(--bone); text-transform: capitalize; }
  .tonight__facts { margin: var(--s4) 0 0; display: grid; gap: var(--s2); }
  .tonight__facts div { display: flex; justify-content: space-between; gap: var(--s4); font-size: var(--t-small); }
  .tonight__facts dt { color: var(--fg-2); }
  .tonight__facts dd { margin: 0; color: var(--bone); font-variant-numeric: tabular-nums; }
  .tonight__note { margin-top: var(--s4); font-size: var(--t-small); line-height: 1.45; color: var(--muted); }
  .links { display: flex; gap: var(--s5); }
  .links a, .menu nav a { color: var(--fg-2); transition: color .2s var(--ease); position: relative; }
  .links a:hover, .links a[aria-current="page"] { color: var(--bone); }
  .links a[aria-current="page"]::after { content: ""; position: absolute; left: 0; right: 0; bottom: -6px; height: 2px; border-radius: 2px; background: var(--blue); }
  .end { display: flex; align-items: center; gap: var(--s2); }
  .tool { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border: 0; background: none; color: var(--fg-2); cursor: pointer; transition: color .2s, transform .2s; }
  .tool:hover { color: var(--bone); }
  .tool:active { transform: scale(.92); }
  .bar__cta { margin-left: var(--s2); height: 2.5rem; }
  .menu-btn { display: none; height: 2.5rem; padding: 0 .9rem; margin-left: var(--s1); border: 0; border-radius: 999px; background: var(--bg-2); color: var(--bone); font: 500 var(--t-small)/1 var(--sans); cursor: pointer; transition: background-color .2s, transform .15s; }
  .menu-btn:active { transform: scale(.95); }

  /* phones: a sticky bar that steps aside while you read and returns when you scroll up */
  @media (max-width: 860px) {
    .bar {
      position: sticky; top: 0; z-index: 20;
      grid-template-columns: 1fr auto; padding-block: var(--s3);
      padding-top: calc(var(--s3) + env(safe-area-inset-top, 0px));
      background: var(--bg);
      transition: transform .3s var(--ease), box-shadow .3s;
    }
    .bar.is-scrolled { box-shadow: 0 1px 0 var(--rule), 0 10px 30px -18px rgb(0 0 0 / .6); }
    .bar.is-hidden { transform: translateY(-110%); }
    .links, .bar__cta, .mark__phase { display: none; }
    .menu-btn { display: inline-block; }
  }

  /* the menu sheet */
  .sheet {
    width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; padding: 0;
    border: 0; background: var(--bg); color: var(--fg);
    padding: calc(var(--s3) + env(safe-area-inset-top, 0px)) var(--margin) calc(var(--s6) + env(safe-area-inset-bottom, 0px));
    overflow-y: auto;
  }
  .sheet[open] { display: flex; flex-direction: column; animation: sheet-in .28s var(--ease); }
  .sheet::backdrop { background: var(--bg); }
  @keyframes sheet-in { from { opacity: 0; translate: 0 -10px; } }
  .sheet__top { display: flex; align-items: center; justify-content: space-between; min-height: 3rem; }
  .sheet__mark { display: inline-flex; align-items: center; gap: .7rem; font-weight: 500; color: var(--bone); }
  .sheet__close { height: 2.5rem; padding: 0 .9rem; border: 0; border-radius: 999px; background: var(--bg-2); color: var(--bone); font: 500 var(--t-small)/1 var(--sans); cursor: pointer; }
  .sheet__close:active { transform: scale(.95); }
  .sheet__nav { margin-top: var(--s7); display: grid; }
  .sheet__nav a { position: relative; display: flex; align-items: baseline; gap: .35em; padding: .55rem 0 .55rem 1.6rem; font: 500 clamp(2rem, 9vw, 2.75rem)/1.15 var(--display); letter-spacing: -.015em; color: var(--fg-2); transition: color .2s, translate .2s var(--ease); }
  .sheet__nav a:active { translate: 4px 0; color: var(--bone); }
  .sheet__nav a[aria-current="page"] { color: var(--bone); }
  .sheet__nav a[aria-current="page"]::before {
    content: ""; position: absolute; left: 0; top: 50%; width: .62em; height: .62em; translate: 0 -40%; font-size: 1.6rem;
    background: var(--blue); -webkit-mask: var(--crescent) center / contain no-repeat; mask: var(--crescent) center / contain no-repeat;
  }
  .sheet__nav sup { font: 400 .875rem/1 var(--sans); letter-spacing: 0; color: var(--blue); }
  .sheet__tonight { margin-top: auto; padding-top: var(--s7); display: flex; align-items: center; gap: var(--s5); }
  .sheet__k { font-size: var(--t-small); color: var(--fg-2); }
  .sheet__phase { margin-top: 2px; font: 500 1.375rem/1.2 var(--display); color: var(--bone); }
  .sheet__phase span:first-child { text-transform: capitalize; }
  .sheet__next { margin-top: 4px; font-size: var(--t-small); color: var(--muted); }
  .sheet__tools { margin-top: var(--s6); display: flex; gap: var(--s3); }
  .sheet__tools .btn { flex: 1; justify-content: center; height: 3rem; border-radius: 999px; }
  @media (min-width: 861px) { .sheet { display: none !important; } }
  @media (prefers-reduced-motion: reduce) { .bar { transition: none; } }
</style>

<script>
  const root = document.documentElement;
  document.querySelectorAll("[data-theme-toggle]").forEach((btn) =>
    btn.addEventListener("click", () => {
      const next = root.dataset.theme === "dawn" ? "night" : "dawn";
      if (next === "dawn") root.dataset.theme = "dawn"; else delete root.dataset.theme;
      try { localStorage.setItem("theme", next); } catch {}
    }));
  const themeName = () => document.querySelectorAll<HTMLElement>("[data-theme-name]")
    .forEach((el) => (el.textContent = root.dataset.theme === "dawn" ? "Switch to night" : "Switch to dawn"));
  themeName();
  document.querySelectorAll("[data-theme-toggle]").forEach((b) => b.addEventListener("click", () => setTimeout(themeName)));

  // menu sheet
  const sheet = document.querySelector<HTMLDialogElement>("[data-sheet]")!;
  document.querySelector("[data-sheet-open]")?.addEventListener("click", () => { sheet.showModal(); root.classList.add("sheet-open"); });
  const closeSheet = () => sheet.close();
  sheet.addEventListener("close", () => root.classList.remove("sheet-open"));
  sheet.querySelector("[data-sheet-close]")?.addEventListener("click", closeSheet);
  sheet.querySelectorAll("a").forEach((a) => a.addEventListener("click", closeSheet));
  sheet.querySelector("[data-sheet-search]")?.addEventListener("click", () => {
    closeSheet();
    document.querySelector<HTMLButtonElement>(".bar [data-palette-open]")?.click();
  });

  // phones: hide the bar while scrolling down, bring it back on any scroll up
  const bar = document.querySelector<HTMLElement>("[data-bar]")!;
  const small = matchMedia("(max-width: 860px)");
  let lastY = scrollY, ticking = false;
  addEventListener("scroll", () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      ticking = false;
      const y = scrollY;
      bar.classList.toggle("is-scrolled", y > 8);
      if (!small.matches) { bar.classList.remove("is-hidden"); lastY = y; return; }
      if (y > lastY + 6 && y > 120) {
        bar.classList.add("is-hidden");
        document.getElementById("tonight")?.hidePopover?.();
      } else if (y < lastY - 6) bar.classList.remove("is-hidden");
      lastY = y;
    });
  }, { passive: true });
  // keyboard users always see where focus is
  bar.addEventListener("focusin", () => bar.classList.remove("is-hidden"));

  // local time where Adarsh is
  const fmt = new Intl.DateTimeFormat("en-GB", { hour: "2-digit", minute: "2-digit", timeZone: "Asia/Kolkata" });
  const tick = () => document.querySelectorAll<HTMLElement>("[data-local-time]").forEach((el) => (el.textContent = fmt.format(new Date())));
  tick();
  setInterval(tick, 30_000);
</script>
